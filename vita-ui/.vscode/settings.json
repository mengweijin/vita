{
	// 保存时的代码修复操作 always: 总是触发整理；explicit: 手动触发整理
	// 使用 "explicit" 的好处：避免意外更改。不建议自动触发。
	"editor.codeActionsOnSave": {
		// 辅助操作：Sort the keys of a JSON object in natural order.
		"source.action.useSortedKeys.biome": "explicit",
		// 启用保存时修复所有可修复的问题。
		"source.fixAll.biome": "explicit",
		// 整理导入的功能：
		// 合并相同来源的导入：多个 import from 'vue' 合并为一个
		// 按字母顺序排序：对导入项进行排序
		// 移除未使用的导入：自动删除未引用的导入
		// 分组排序：通常按第三方库 → 内部模块的顺序
		"source.organizeImports": "explicit",
		// 导入排序
		"source.organizeImports.biome": "explicit"
	},
	// 默认格式化工具：Biome
	"editor.defaultFormatter": "biomejs.biome",
	// 粘贴时自动格式化
	"editor.formatOnPaste": false,
	// 保存时自动格式化
	"editor.formatOnSave": true,
	// 输入时自动格式化
	"editor.formatOnType": false,
	// 括号配对引导线显示
	"editor.guides.bracketPairs": "active",
	// 是否启用文件嵌套功能，将相关文件分组显示
	"explorer.fileNesting.enabled": false,
	// 文件自动保存设置：关闭
	"files.autoSave": "off",
	// JavaScript 导入路径偏好
	"javascript.preferences.importModuleSpecifier": "non-relative",
	// 自动导入时是否包含文件扩展名。js: 包含完整路径
	"javascript.preferences.importModuleSpecifierEnding": "js",
	// 建议时自动完成 JSDoc 标签
	"javascript.suggest.completeJSDocs": true,
	// 关闭VSCode原生的路径建议，避免与Path Intellisense插件冲突
	"javascript.suggest.paths": false,
	// 关闭VSCode对 JavaScript 的内置验证，使用 Biome 进行验证
	"javascript.validate.enable": false,
	// 路径智能感知设置：强制在导入语句中包含文件扩展名
	"path-intellisense.extensionOnImport": true,
	// 配置路径别名映射（适用于使用了路径别名的项目）
	"path-intellisense.mappings": {
		// @ 别名映射到 src 目录（常见于Vue/React项目）
		"@": "${workspaceFolder}/src"
	},
	// 显示隐藏文件（以.开头的文件）
	"path-intellisense.showHiddenFiles": true,
	// TypeScript 导入路径偏好
	"typescript.preferences.importModuleSpecifier": "non-relative",
	// 自动导入时是否包含文件扩展名。js: 包含完整路径
	"typescript.preferences.importModuleSpecifierEnding": "js",
	// 关闭VSCode原生的路径建议，避免与Path Intellisense插件冲突
	"typescript.suggest.paths": false,
	// 关闭VSCode对 TypeScript 的内置验证，使用 Biome 进行验证
	"typescript.validate.enable": false,
	// 指定当前项目使用 vscode-icons 作为图标主题
	"workbench.iconTheme": "vscode-icons"
}
