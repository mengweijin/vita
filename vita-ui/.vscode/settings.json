{
  // 保存时的代码修复操作 always: 总是触发整理；explicit: 手动触发整理
  // 使用 "explicit" 的好处：避免意外更改。不建议自动触发。
  "editor.codeActionsOnSave": {
    // 启用保存时修复所有可修复的问题。
    "source.fixAll.oxc": "always"
  },
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  // 粘贴时自动格式化
  "editor.formatOnPaste": false,
  // 保存时自动格式化
  "editor.formatOnSave": true,
  // 输入时自动格式化
  "editor.formatOnType": false,
  // 括号配对引导线显示
  "editor.guides.bracketPairs": "active",
  // 是否启用文件嵌套功能，将相关文件分组显示
  "explorer.fileNesting.enabled": false,
  // 文件自动保存设置：关闭
  "files.autoSave": "off",
  // JavaScript/TypeScript 导入路径偏好
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  // 自动导入时是否包含文件扩展名。js: 包含完整的 .js/.ts 路径
  "js/ts.preferences.importModuleSpecifierEnding": "js",
  // 建议时自动完成 JSDoc 标签
  "js/ts.suggest.jsdoc.enabled": true,
  // 是否开启VSCode原生的路径建议。
  "js/ts.suggest.paths": true,
  // 是否开启VSCode对 JavaScript/TypeScript 的内置验证
  "js/ts.validate.enabled": false,
  // 指定当前项目使用 vscode-icons 作为图标主题
  "workbench.iconTheme": "vscode-icons"
}
