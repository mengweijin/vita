# ========================================
# 自动检测文本文件
# ========================================
* text=auto

# ========================================
# 源代码文件 - 强制 LF 换行
# ========================================
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.json text eol=lf
*.html text eol=lf
*.vue text eol=lf
*.svelte text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# ========================================
# Vite 相关文件
# ========================================
vite.config.* text eol=lf
.env* text eol=lf
.env.* text eol=lf
*.env text eol=lf

# ========================================
# 构建产物和依赖 - 视为二进制
# ========================================
dist/**/* binary
build/**/* binary
*.min.js binary
*.min.css binary
*.min.js.map binary
*.min.css.map binary
package-lock.json binary
yarn.lock binary
pnpm-lock.yaml binary
bun.lockb binary

# ========================================
# 测试相关文件
# ========================================
coverage/**/* linguist-vendored
*.snap binary

# ========================================
# 特殊文件类型
# ========================================
*.sh text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# ========================================
# 图像和媒体文件
# ========================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.webm binary

# ========================================
# 字体文件
# ========================================
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# ========================================
# 其他二进制文件
# ========================================
*.pdf binary
*.doc binary
*.docx binary
*.zip binary
*.tar binary
*.gz binary
*.rar binary
