  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengweijin/vita.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:java": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build --mode staging && node copy-dist.js",
    "copy:dist": "node copy-dist.js",
    "lint": "oxlint",
    "lint:github": "oxlint --format=github",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "rimraf": "rimraf dist && rimraf pnpm-lock.yaml && rimraf types && pnpm clean",
    "preinstall": "npx only-allow pnpm",
    "check": "npm-check -u"
  },
  "dependencies": {
    "@file-viewer/vue3-full": "^2.4.0",
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "@iconify-json/ant-design": "^1.2.8",
    "@iconify-json/ep": "1.2.4",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/vue": "5.0.1",
    "@vueuse/core": "14.4.0",
    "@wangeditor-next/editor": "^6.2.0",
    "@wangeditor-next/editor-for-vue": "^6.2.0",
    "axios": "1.20.0",
    "cronstrue": "^3.24.0",
    "cropperjs": "^2.2.0",
    "default-passive-events": "^4.0.0",
    "echarts": "6.1.0",
    "element-plus": "2.14.5",
    "highlight.js": "^11.12.0",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "6.15.3",
    "sse.js": "^2.8.0",
    "swagger-ui-dist": "5.32.14",
    "vue": "3.5.42",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "5.3.0",
    "xe-utils": "4.0.12"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@vitejs/devtools": "0.6.2",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-vue": "6.0.8",
    "cross-env": "^10.1.0",
    "fs-extra": "11.4.0",
    "globals": "17.11.0",
    "npm-check": "^6.0.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "rimraf": "6.1.3",
    "sharp": "0.35.4",
    "svgo": "^4.1.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.2.2"
  }
