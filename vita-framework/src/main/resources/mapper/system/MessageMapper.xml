<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.github.mengweijin.vita.system.mapper.MessageMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.github.mengweijin.vita.system.domain.entity.MessageDO">
        <result column="CATEGORY" property="category"/>
        <result column="TITLE" property="title"/>
        <result column="CONTENT" property="content"/>
        <result column="ID" property="id"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="BaseColumn">
        t.CATEGORY,
        t.TITLE,
        t.CONTENT,
        t.ID,
        t.CREATE_BY,
        t.CREATE_TIME,
        t.UPDATE_BY,
        t.UPDATE_TIME
    </sql>

    <!-- 通用 Equal 查询条件列 -->
    <sql id="BaseQueryConditionEqual">
        <if test="p.id != null">
            and t.ID = #{p.id}
        </if>
        <if test="p.createBy != null and p.createBy != ''">
            and t.CREATE_BY = #{p.createBy}
        </if>
        <if test="p.createTime != null">
            and t.CREATE_TIME = #{p.createTime}
        </if>
        <if test="p.updateBy != null and p.updateBy != ''">
            and t.UPDATE_BY = #{p.updateBy}
        </if>
        <if test="p.updateTime != null">
            and t.UPDATE_TIME = #{p.updateTime}
        </if>

        <if test="p.category != null and p.category != ''">
            and t.CATEGORY = #{p.category}
        </if>
        <if test="p.title != null and p.title != ''">
            and t.TITLE = #{p.title}
        </if>
        <if test="p.content != null and p.content != ''">
            and t.CONTENT = #{p.content}
        </if>

    </sql>

    <!-- 通用 Like 查询条件列 -->
    <sql id="BaseQueryConditionLike">
        <if test="p.id != null">
            and t.ID = #{p.id}
        </if>
        <if test="p.createBy != null and p.createBy != ''">
            and t.CREATE_BY = #{p.createBy}
        </if>
        <if test="p.createTime != null">
            and t.CREATE_TIME = #{p.createTime}
        </if>
        <if test="p.updateBy != null and p.updateBy != ''">
            and t.UPDATE_BY = #{p.updateBy}
        </if>
        <if test="p.updateTime != null">
            and t.UPDATE_TIME = #{p.updateTime}
        </if>

        <if test="p.category != null and p.category != ''">
            and t.CATEGORY = #{p.category}
        </if>
        <if test="p.title != null and p.title != ''">
            and t.TITLE like concat(concat('%', #{p.title}), '%')
        </if>
        <if test="p.content != null and p.content != ''">
            and t.CONTENT like concat(concat('%', #{p.content}), '%')
        </if>
    </sql>

</mapper>
